# Copia este archivo con el nombre ".env" y llena tus datos.
# El archivo .env es privado: NO lo compartas ni lo subas a GitHub (ya está en .gitignore).

# ── Correos reales con Gmail (opcional) ─────────────────────────────────────────
# Si no llenas esto, la app sigue funcionando con correos de prueba (Ethereal).
# GMAIL_APP_PASSWORD NO es tu contraseña normal: es una "contraseña de aplicación" (ver README).
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── A qué correo avisar cuando llegue una reserva nueva (opcional) ──────────────
# Si no lo pones, se usa el correo del admin (por defecto admin@verticeinmobiliario.com, que no existe).
ADMIN_NOTIFY_EMAIL=tucorreo@gmail.com
